# /etc/systemd/system/ragfarm-vllm@.service   (runs on HOST, needs the GB10 GPU)
#
# TEMPLATED unit: one instance per vLLM SLOT. %i is the slot number.
#   systemctl start ragfarm-vllm@0     -> 127.0.0.1:8080/v1
#   systemctl start ragfarm-vllm@1     -> 127.0.0.1:8082/v1
# (8081 is the reranker, 8090 the embedder, 8000 mcpo, 8104 rag-retrieval.)
#
# WHY SLOTS EXIST: vLLM serves exactly ONE base model per process — several
# --served-model-name values are aliases for the SAME weights, and LoRA adapters
# need a shared base. Two resident models therefore means two processes, which is
# what lets Open WebUI switch model mid-chat with the conversation intact.
#
# CONFIG COMES FROM TWO FILES, in this order:
#   .env         global, hand-maintained (MAX_JOBS, backend, context length, ...)
#   .env.slotN   generated by scripts/activate_llm.py — model path, alias, port,
#                and the per-slot --gpu-memory-utilization it derived
# Never hand-edit .env.slotN; run scripts/activate_llm.py -s N instead.
[Unit]
Description=ragfarm vLLM slot %i (CUDA/GB10, sm_121)
After=network-online.target
# Give up rather than crash-loop. A 30B checkpoint takes minutes to load, so a
# broken config looks exactly like a slow start: without a limit this unit once
# restarted 99 times over several hours while `systemctl is-active` kept saying
# activating/active. 3 attempts in 30 min then `failed` makes breakage visible.
StartLimitBurst=3
StartLimitIntervalSec=1800

[Service]
User=dave
EnvironmentFile=-/home/dave/ragfarm/.env
EnvironmentFile=/home/dave/ragfarm/.env.slot%i
# PATH is PLUMBING, not config — without it the service cannot start at all.
# FlashInfer JIT-compiles kernels on first use and shells out to `ninja` + `nvcc`.
# ninja lives INSIDE .venv-vllm and nvcc in the CUDA toolkit; systemd's default
# PATH has neither, and invoking the venv's binary by absolute path does NOT put
# its siblings on PATH the way `activate` does. Without this the engine dies with
#   FileNotFoundError: [Errno 2] No such file or directory: 'ninja'
# AFTER loading every shard, so it reads as a slow model load, not a missing tool.
Environment=PATH=/home/dave/ragfarm/.venv-vllm/bin:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/bin
Environment=CUDA_HOME=/usr/local/cuda
# MAX_JOBS lives in .env (a tunable number is config). It is LOAD-BEARING: unset,
# ninja runs nproc+2 = 22 parallel CUDA compiles and the OOM killer takes the
# service at ~98 GB. See ADR-0013 §5a — that is a DIFFERENT budget from
# --gpu-memory-utilization, and lowering the vLLM memory flags does nothing for it.
WorkingDirectory=/home/dave/ragfarm
ExecStart=/home/dave/ragfarm/.venv-vllm/bin/vllm serve ${LLM_MODEL_PATH} \
  --served-model-name ${LLM_SERVED_NAME} \
  --host 127.0.0.1 --port ${LLM_PORT} \
  --moe-backend ${LLM_MOE_BACKEND} \
  --enable-auto-tool-choice --tool-call-parser hermes \
  --reasoning-parser ${LLM_REASONING_PARSER} \
  --max-model-len ${LLM_MAX_MODEL_LEN} \
  --gpu-memory-utilization ${LLM_GPU_MEM_UTIL} \
  --max-num-batched-tokens ${LLM_MAX_NUM_BATCHED_TOKENS} \
  --max-num-seqs ${LLM_MAX_NUM_SEQS}
# --gpu-memory-utilization is PER SLOT and each instance computes its fraction of
# the WHOLE GPU independently — they do not coordinate. Two slots at the
# single-model 0.50 will OOM. activate_llm.py derives each slot's value from the
# checkpoint size and refuses to exceed a total ceiling.
#
# --reasoning-parser separates a Thinking model's <think> block into
# reasoning_content so Open WebUI renders it as a collapsible trace instead of
# mixing it into the answer. Harmless for Instruct models, which emit no block.
TimeoutStartSec=1200
# Shutdown is slow too (engine core + worker procs); the default 90s SIGTERM
# window expired repeatedly and systemd fell back to SIGKILL on every stop.
TimeoutStopSec=180
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
