# /etc/systemd/system/ragfarm-stack.service
# Brings up the containerized ragfarm layer (qdrant + rag-retrieval + mcpo +
# open-webui) on boot as a single unit. The containers also carry
# restart: unless-stopped, so a normal reboot already restarts them while docker
# is enabled; this unit additionally guarantees the whole stack comes up even if
# it was explicitly stopped, orders it after the host services, and gives one
# control point (systemctl start/stop ragfarm-stack).
#
# Install (one-time, as root):
#   sudo cp manifests/ragfarm-stack.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ragfarm-stack.service
#
# The host services (ragfarm-llama, ragfarm-embedder) have their own units and
# must be enabled separately; this stack tolerates them starting late (containers retry).
[Unit]
Description=ragfarm container stack (qdrant, rag-retrieval, mcpo, open-webui)
Requires=docker.service
After=docker.service network-online.target ragfarm-llama.service ragfarm-embedder.service ragfarm-ingester-watcher.service
Wants=network-online.target ragfarm-llama.service ragfarm-embedder.service ragfarm-ingester-watcher.service

[Service]
Type=oneshot
RemainAfterExit=true
User=dave
WorkingDirectory=/home/dave/ragfarm
# Load repo-root .env proxy vars (no-op if unset), then bring up the operational
# PoC services explicitly. placement + host-control run in MOCK mode by default
# (ONE_MOCK/HOST_MOCK) so the agent + confirmation UX work with no OpenNebula.
# (mcp-fs + ingester are omitted — not part of the running agent path.)
# `docker compose` needs no sudo (dave is in the docker group).
ExecStart=/bin/bash -lc 'source scripts/proxy-env.sh && /usr/bin/docker compose -f infra/compose.yaml up -d qdrant rag-retrieval mcp-placement mcp-host-control mcpo open-webui'
# mcpo races its MCP backends on boot and comes up degraded (100% CPU spin,
# host-control unmounted). Wait for backends to listen, then restart mcpo once so
# it mounts all tools cleanly. Best-effort; see scripts/mcpo-heal.sh.
ExecStartPost=/home/dave/ragfarm/scripts/mcpo-heal.sh
ExecStop=/usr/bin/docker compose -f /home/dave/ragfarm/infra/compose.yaml stop qdrant rag-retrieval mcp-placement mcp-host-control mcpo open-webui
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
