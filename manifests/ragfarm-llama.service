# ExecStart invokes llama.cpp's own binary, which is genuinely named `llama-server`
# (ADR-0005 short name: "llama") — that binary name is upstream's, not ours to rename.
[Unit]
Description=llama.cpp server (Qwen2.5-7B-Instruct, Vulkan/iGPU)
After=network-online.target
[Service]
User=dave
LimitMEMLOCK=infinity
# LLM_GGUF_PATH default matches `scripts/fetch-llm.sh`'s default fetch target;
# EnvironmentFile is loaded AFTER so a value in .env (written by fetch-llm.sh when
# you swap models, or by hand) OVERRIDES this default — same for proxy vars.
# LLM_GGUF_MMPROJ default is empty: text-only models pass no --mmproj. fetch-llm.sh
# auto-detects a vision model and sets this in .env (activate-llm.sh does the same
# when switching among models already on disk), overriding this default.
# CONFIG LIVES IN .env, NOT HERE — this unit carries start/stop/restart POLICY only.
# The model-path default that used to sit here was stripped 2026-08-03: it pinned a
# specific checkpoint, which goes stale the moment the model is swapped (it still
# named a Qwen2.5 GGUF). If .env is missing the service should fail loudly rather
# than silently serve the wrong model.
EnvironmentFile=-/home/dave/ragfarm/.env
WorkingDirectory=/home/dave/llama.cpp
# ExecStart delegates to a wrapper script (scripts/llama-launch.sh) rather than
# inlining `${LLM_GGUF_MMPROJ:+--mmproj ...}` here: systemd does its OWN $VAR
# substitution on ExecStart= before any shell sees it and does NOT understand
# bash's :+ operator, so that inline form risks systemd mangling it — unverifiable
# without a live restart. The wrapper is plain bash, fully testable offline
# (LLAMA_LAUNCH_DRY_RUN=1), and does the one conditional itself. Same flags as
# before, byte-for-byte, when LLM_GGUF_MMPROJ is unset.
ExecStart=/home/dave/ragfarm/scripts/llama-launch.sh
Restart=on-failure
[Install]
WantedBy=multi-user.target
