# /etc/systemd/system/ragfarm-llama.service  (runs on HOST, needs iGPU)
# ExecStart invokes llama.cpp's own binary, which is genuinely named `llama-server`
# (ADR-0005 short name: "llama") — that binary name is upstream's, not ours to rename.
[Unit]
Description=llama.cpp server (Qwen2.5-7B-Instruct, Vulkan/iGPU)
After=network-online.target
[Service]
User=dave
# LLM_GGUF_PATH default matches `scripts/fetch-llm.sh`'s default fetch target;
# EnvironmentFile is loaded AFTER so a value in .env (written by fetch-llm.sh when
# you swap models, or by hand) OVERRIDES this default — same for proxy vars.
Environment=LLM_GGUF_PATH=/home/dave/ragfarm/models/llm/qwen2.5-7b-instruct-gguf/qwen2.5-7b-instruct-q4_k_m-00001-of-00002.gguf
EnvironmentFile=-/home/dave/ragfarm/.env
WorkingDirectory=/home/dave/llama.cpp
ExecStart=/home/dave/llama.cpp/build/bin/llama-server \
  -m ${LLM_GGUF_PATH} \
  --host 127.0.0.1 --port 8080 -ngl 999 -c 32768 --context-shift --keep 3072 --jinja \
  --top-k 1 --top-p 0 --min-p 0 --seed 42 --temperature 0 -fa -v --mlock --mmap --alias qwen2.5-7b-instruct
Restart=on-failure
[Install]
WantedBy=multi-user.target
