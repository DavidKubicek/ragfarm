# /etc/systemd/system/ragfarm-reranker.service  (runs on HOST, needs iGPU)
# Second llama.cpp server, dedicated to reranking: bge-reranker-v2-m3 as a GGUF on
# the iGPU via Vulkan (ADR-0008). Same binary as ragfarm-llama, different model and
# the --reranking endpoint. Replaces the old CPU cross-encoder that ran inside the
# embedder (~36 s/query on CPU -> ~1.7 s on the iGPU). No ROCm (gfx1150 unofficial);
# Vulkan, exactly like the LLM.
#
# The GGUF is generated (not committed; gitignored) by `scripts/fetch-encoder.sh`
# from the cached HF weights — see models/reranker/MODEL.md.
[Unit]
Description=llama.cpp reranker (bge-reranker-v2-m3, Vulkan/iGPU)
After=network-online.target

[Service]
User=dave
# RERANK_GGUF_PATH default matches `scripts/fetch-encoder.sh`'s default fetch
# target; EnvironmentFile is loaded AFTER so a value in .env (written by
# fetch-encoder.sh when you swap models, or by hand) OVERRIDES this default.
# CONFIG LIVES IN .env, NOT HERE — this unit carries start/stop/restart POLICY only.
# The model-path default that used to sit here was stripped 2026-08-03: it pinned a
# specific checkpoint, which goes stale the moment the model is swapped (it still
# named a Qwen2.5 GGUF). If .env is missing the service should fail loudly rather
# than silently serve the wrong model.
EnvironmentFile=-/home/dave/ragfarm/.env
WorkingDirectory=/home/dave/llama.cpp
ExecStart=/home/dave/llama.cpp/build/bin/llama-server \
  -m ${RERANK_GGUF_PATH} \
  --reranking --host 127.0.0.1 --port 8081 -ngl 999 --mlock --mmap \
  -b 4096 -ub 4096 \
  --alias bge-reranker-v2-m3
# -b/-ub 4096: reranking scores each (query,doc) pair in ONE physical batch, so the
# batch must exceed the longest pair. Default 512 < our ~480-word chunks (~600-700
# tokens); 4096 gives ample headroom. (The old CPU FlagReranker silently truncated
# to 512 instead — llama.cpp scores the full text, which is strictly better.)
Restart=on-failure

[Install]
WantedBy=multi-user.target
