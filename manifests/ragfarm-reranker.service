# /etc/systemd/system/ragfarm-reranker.service  (runs on HOST, needs the GB10 GPU)
# llama.cpp server dedicated to reranking: bge-reranker-v2-m3 as a GGUF on CUDA
# (ADR-0008, ADR-0013 §3). This is the ONLY thing llama.cpp still serves —
# generation moved to vLLM (manifests/ragfarm-vllm.service) on the Spark.
#
# The GGUF is generated (not committed; gitignored) by `scripts/fetch-encoder.sh`
# from the cached HF weights — see models/reranker/MODEL.md.
[Unit]
Description=llama.cpp reranker (bge-reranker-v2-m3, CUDA/GB10)
After=network-online.target

[Service]
User=dave
# ADR-0013 §3: the reranker runs at LOWERED priority so the interactive LLM wins
# contention. Nice=5 is deliberately mild — we are single-user for now and the
# point is to observe how much these actually fight before tuning harder.
#
# HONEST LIMIT: Nice is CPU scheduling only. It does NOT deprioritise GPU work —
# kernel ordering on the device is the driver's business, and nothing here yields
# GPU time to vLLM. What it does buy is the host-side half (HTTP, tokenisation,
# sampling, the batch marshalling around each rerank call). If real GPU contention
# shows up, the levers are CUDA MPS priorities or simply not running a bulk rerank
# concurrently with interactive generation — see docs/deployment.md.
Nice=5
# RERANK_MODEL_PATH is written by `scripts/fetch-encoder.sh` into .env, which the
# EnvironmentFile below loads.
# CONFIG LIVES IN .env, NOT HERE — this unit carries start/stop/restart POLICY only.
# The model-path default that used to sit here was stripped 2026-08-03: it pinned a
# specific checkpoint, which goes stale the moment the model is swapped (it still
# named a Qwen2.5 GGUF). If .env is missing the service should fail loudly rather
# than silently serve the wrong model.
EnvironmentFile=-/home/dave/ragfarm/.env
WorkingDirectory=/home/dave/llama.cpp
ExecStart=/home/dave/llama.cpp/build/bin/llama-server \
  -m ${RERANK_MODEL_PATH} \
  --reranking --host 127.0.0.1 --port 8081 -ngl 999 --mlock --mmap \
  -b 4096 -ub 4096 \
  --alias bge-reranker-v2-m3
# -b/-ub 4096: reranking scores each (query,doc) pair in ONE physical batch, so the
# batch must exceed the longest pair. Default 512 < our ~480-word chunks (~600-700
# tokens); 4096 gives ample headroom. (The old CPU FlagReranker silently truncated
# to 512 instead — llama.cpp scores the full text, which is strictly better.)
Restart=on-failure

[Install]
WantedBy=multi-user.target
