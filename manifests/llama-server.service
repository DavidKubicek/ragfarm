# /etc/systemd/system/llama-server.service  (runs on HOST, needs iGPU)
[Unit]
Description=llama.cpp server (Qwen2.5-7B-Instruct, Vulkan/iGPU)
After=network-online.target
[Service]
User=dave
WorkingDirectory=/opt/ragfarm/llama.cpp
ExecStart=/opt/ragfarm/llama.cpp/build/bin/llama-server \
  -m /opt/ragfarm/models/gguf/Qwen2.5-7B-Instruct-Q4_K_M.gguf \
  --host 127.0.0.1 --port 8080 -ngl 999 -c 16384 --jinja \
  --alias qwen2.5-7b-instruct
Restart=on-failure
[Install]
WantedBy=multi-user.target
