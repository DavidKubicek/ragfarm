# Copy to .env and fill in. Do NOT commit .env.
# Loaded via infra/compose.yaml's `env_file` for this service only (optional —
# required: false — so compose still runs before this file exists, in mock mode).
# ONE_MOCK itself lives in the repo-root .env.example, not here.
ONE_XMLRPC=http://opennebula.infra.local:2633/RPC2
ONE_AUTH=oneadmin:replace-with-token
