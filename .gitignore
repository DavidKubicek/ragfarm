.env
# model weights live under models/<kind>/<model-slug>/ — data only, fetched by
# scripts/fetch-llm.sh / fetch-encoder.sh, never committed. MODEL.md files at
# models/<kind>/MODEL.md (one level up) stay tracked as the record.
models/*/*/
__pycache__/
*.pyc
# logs/* not logs/ — git cannot re-include a file inside an excluded directory,
# so the contents are ignored and .keep is negated. This keeps the directory
# present in a fresh clone: every build step writes logs/<NN-stepname>.log, and a
# missing logs/ makes `tee` fail SILENTLY inside a pipeline (the log is discarded
# and the step still looks like it passed).
logs/*
!logs/.keep
.env
.venv/
.venv-rocm/
# vLLM gets its OWN venv (ADR-0013 / step 02): installing it into .venv would
# downgrade torch off the cu130 build and bump numpy/transformers under the
# frozen ingester. Nothing imports vllm — it is reached over HTTP on :8080.
.venv-vllm/
.claude/
services/ingester/manifest.db*
services/ingester/known-good.constraints.txt
tests/*.json

# draw.io viewer JS (4MB blob, re-fetch from viewer.diagrams.net)

# drawio webapp mirror — 151 MB from jgraph/drawio; rehydrate with
# scripts/fetch-drawio-viewer.sh. Two files are custom and tracked:
#   index.html         — ragfarm landing page
#   drawio-editor.html — renamed upstream editor entrypoint
infra/drawio-viewer/*
!infra/drawio-viewer/index.html
!infra/drawio-viewer/drawio-editor.html
!infra/drawio-viewer/fixtures/
!infra/drawio-viewer/fixtures/.keep


# harness reference JSONs — untracked
tests/qwen3-vl_*_prompt-results.json
# backups/ — same reasoning as logs/: keep the directory, ignore its contents.
# Convention: pre-upgrade snapshots land here (e.g. the OWUI sqlite DB before a
# version bump), so the dir must exist in a fresh clone.
backups/*
!backups/.keep
# editor swap files — never commit (a live vim leaves these behind)
*.swp
*.swo
*~
