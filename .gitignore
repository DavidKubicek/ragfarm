.env
# model weights live under models/<kind>/<model-slug>/ — data only, fetched by
# scripts/fetch-llm.sh / fetch-encoder.sh, never committed. MODEL.md files at
# models/<kind>/MODEL.md (one level up) stay tracked as the record.
models/*/*/
__pycache__/
*.pyc
logs/
.env
.venv/
.venv-rocm/
.claude/
services/ingester/manifest.db*
services/ingester/known-good.constraints.txt
tests/*.json

# draw.io viewer JS (4MB blob, re-fetch from viewer.diagrams.net)

# drawio webapp mirror — 151 MB from jgraph/drawio; rehydrate with
# scripts/fetch-drawio-viewer.sh. Two files are custom and tracked:
#   index.html         — ragfarm landing page
#   drawio-editor.html — renamed upstream editor entrypoint
infra/drawio-viewer/*
!infra/drawio-viewer/index.html
!infra/drawio-viewer/drawio-editor.html
!infra/drawio-viewer/fixtures/
!infra/drawio-viewer/fixtures/.keep


# harness reference JSONs — untracked
tests/qwen3-vl_*_prompt-results.json
backups/
